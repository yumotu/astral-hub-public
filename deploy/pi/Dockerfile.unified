# Preserve the verified Pi runtime and all its installed dependencies.
# Build context is deploy/pi, never a production HOME or plugins directory.
ARG BASE_IMAGE=astral-pi:1.4.0-v0810-sandbox1
FROM ${BASE_IMAGE}
ARG SOURCE_COMMIT
LABEL org.opencontainers.image.version="0.8.15" org.opencontainers.image.revision=${SOURCE_COMMIT}
WORKDIR /bridge
COPY --chown=node:node rpc-worker.mjs assistant-artifacts.mjs ./
USER node
