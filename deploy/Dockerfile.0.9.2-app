# Incremental 0.9.2 App rollout from the verified 0.9.1 runtime.
# Dependencies, data mounts, DSH and Pi images remain independent.
ARG BASE_IMAGE=astral-hub:0.9.1
FROM ${BASE_IMAGE}
ARG SOURCE_COMMIT
LABEL org.opencontainers.image.version="0.9.2" org.opencontainers.image.revision=${SOURCE_COMMIT} org.opencontainers.image.base.digest="sha256:b7bc939ee56c327dfbafa40adc26952d8529850684e2ad715f0a39580b1301ce"
WORKDIR /app
COPY --chown=node:node package.json package-lock.json /tmp/astral-release/
RUN node --input-type=module -e 'import assert from "node:assert/strict"; import fs from "node:fs"; for (const name of ["package.json","package-lock.json"]) { const old=JSON.parse(fs.readFileSync(name)), next=JSON.parse(fs.readFileSync("/tmp/astral-release/"+name)); delete old.version; delete next.version; delete old.releaseName; delete next.releaseName; if(old.packages?.[""])delete old.packages[""].version; if(next.packages?.[""])delete next.packages[""].version; assert.deepEqual(next,old,"Dependency or package metadata changed; build a fresh runtime instead."); fs.copyFileSync("/tmp/astral-release/"+name,name); } fs.rmSync("/tmp/astral-release",{recursive:true});'
USER root
RUN node --input-type=module -e 'import fs from "node:fs"; for (const name of ["server","shared"]) fs.rmSync("/app/"+name,{recursive:true,force:true});'
COPY --chown=node:node server ./server
COPY --chown=node:node shared ./shared
COPY --chown=node:node integrations/dsh-domestic-investment ./integrations/dsh-domestic-investment
RUN node --input-type=module -e 'import fs from "node:fs"; for (const name of fs.readdirSync("/app/dist")) fs.rmSync("/app/dist/"+name,{recursive:true,force:true});'
COPY --chown=node:node dist ./dist
COPY --chown=node:node deploy/pi/assistant-artifacts.mjs ./deploy/pi/assistant-artifacts.mjs
USER node
