{
  "name": "astral-hub",
  "version": "0.8.9",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "init": "node scripts/init.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "node --env-file-if-exists=.env --watch server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "pretest": "node scripts/package-agent.mjs",
    "test": "node --test tests/*.test.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "desktop:dev": "npm run build && npm --prefix desktop start",
    "desktop:package": "npm run build && npm --prefix desktop run package",
    "cards": "node scripts/generate-cards.mjs",
    "prebuild": "npm run cards && node scripts/prepare-preview.mjs && node scripts/package-agent.mjs --web",
    "icons": "node scripts/brand-icons.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^7.4.3",
    "@capacitor/geolocation": "7.1.8",
    "@capacitor/local-notifications": "7.0.7",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/merge": "6.12.3",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "codemirror": "6.0.2",
    "fflate": "0.8.3",
    "html-to-text": "^10.0.1",
    "imapflow": "^2.10.0",
    "leaflet": "1.9.4",
    "lucide-react": "^0.468.0",
    "mailparser": "^3.14.1",
    "mammoth": "1.13.0",
    "nodemailer": "^10.3.1",
    "pdfjs-dist": "6.5.438",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "read-excel-file": "9.3.14",
    "remark-gfm": "^4.0.1",
    "sanitize-html": "2.18.1",
    "web-push": "3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/cli": "^7.4.3",
    "@resvg/resvg-js": "2.6.2",
    "@types/leaflet": "1.9.21",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.9",
    "prettier": "^3.9.10",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
