# 服务器模式可在此配置 DeepSeek；本机直连的密钥在设备界面填写。
APP_TOKEN=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
PI_BRIDGE_URL=
PI_BRIDGE_TOKEN=
# 可选：Gmail 应用专用密码的加密密钥；留空则由 APP_TOKEN 派生。更换后已保存的邮箱需要重新连接。
MAIL_SECRET=
HOST=127.0.0.1
PORT=8787
DATA_DIR=./data
# 原生安卓、桌面和网页来源，多个来源用英文逗号分隔，不支持 *。
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1:5188,http://localhost:5188,https://localhost,astral://app

# Pi 全局并发 1–32；单用户并发不得超过全局值。小型服务器建议默认 4。
PI_MAX_CONCURRENT=0
