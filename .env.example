# 服务器模式可在此配置 DeepSeek；本机直连的密钥在设备界面填写。
APP_TOKEN=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
PI_BRIDGE_URL=
PI_BRIDGE_TOKEN=
# 可选：Gmail 应用专用密码的加密密钥；留空则由 APP_TOKEN 派生。更换后已保存的邮箱需要重新连接。
MAIL_SECRET=
HOST=127.0.0.1
PORT=8787
DATA_DIR=./data
# 原生安卓、桌面和网页来源，多个来源用英文逗号分隔，不支持 *。
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1:5188,http://localhost:5188,https://localhost,astral://app

# Pi 全局并发 1–32；单用户并发不得超过全局值。小型服务器建议默认 4。
PI_MAX_CONCURRENT=0

# DSH Remote 仍在接入验收中，默认关闭；只读连接目录的试验入口。
DSH_REMOTE_ENABLED=0
# 会话/发送/问答实验另行启用；需完成固定版本主机验收。
DSH_REMOTE_CHAT_ENABLED=0
# 管理员明确允许的 HTTPS origin，英文逗号分隔；不接受任意客户端地址或跨源中继跳转。
DSH_REMOTE_ALLOWED_ORIGINS=
# 可选：供已配置星屿工具插件的DSH主机访问的固定HTTPS入口。留空关闭软件工具桥。
# 格式：https://<星屿服务>/api/agent/dsh/app-access
DSH_APP_TOOLS_URL=
